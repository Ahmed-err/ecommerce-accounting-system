generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  firstName     String?
  lastName      String?
  phone         String?   @unique
  role          Role      @default(CUSTOMER)
  avatar        String?
  gender              String?
  dateOfBirth         DateTime?
  prefLanguage        String?   @default("ar")
  prefTheme           String?   @default("system")
  prefCurrency        String?
  newsletterSubscribed  Boolean   @default(true)
  notifyOrderStatusEmail Boolean  @default(true)
  notifyPromoEmail    Boolean   @default(true)
  notifyNewArrivalsEmail Boolean @default(true)
  notifyWhatsapp      Boolean   @default(false)
  marketingUnsubscribed Boolean @default(false)
  accountDeletedAt    DateTime?
  salary            Float?
  hireDate          DateTime?
  department        String?
  isActive          Boolean   @default(true)
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  accounts          Account[]
  orders            Order[]
  sessions          Session[]
  auditLogs         AuditLog[]
  addresses         UserAddress[]
  stockMovements    StockMovement[]
  attendances       Attendance[]
  salaryRecords     SalaryRecord[]
  leaveRequests     LeaveRequest[]
  reviews           Review[]
  reviewHelpfulVotes ReviewHelpfulVote[]
  wishlistItems     WishlistItem[]
  notifications     Notification[]
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  image       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Supplier {
  id           String           @id @default(cuid())
  name         String
  companyName  String?
  phone        String?
  email        String?
  address      String?          @db.Text
  taxId        String?
  paymentTerms String?
  notes        String?          @db.Text
  category     String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  products     Product[]
  movements    StockMovement[]
  purchases    Purchase[]
}

model Product {
  id             String           @id @default(cuid())
  name           String
  nameEn         String?
  nameAr         String?
  description    String?
  descriptionEn  String?
  descriptionAr  String?
  sku            String           @unique
  barcode        String?          @unique
  unit           String           @default("pcs")
  purchasePrice  Decimal          @db.Decimal(12, 2)
  sellingPrice   Decimal          @db.Decimal(12, 2)
  stock          Int              @default(0)
  minStock       Int              @default(5)
  images         String[]
  isActive       Boolean          @default(true)
  compareAtPrice Decimal?         @db.Decimal(12, 2)
  specs          Json?
  highlights     Json?
  categoryId     String
  supplierId     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  orderItems     OrderItem[]
  returnItems    OrderReturnItem[]
  category       Category         @relation(fields: [categoryId], references: [id])
  supplier       Supplier?        @relation(fields: [supplierId], references: [id])
  stockMovements StockMovement[]
  reviews        Review[]
  wishlistItems  WishlistItem[]
  stockAlerts    ProductStockAlert[]
  purchaseItems  PurchaseItem[]

  @@index([categoryId, isActive])
  @@index([supplierId])
}

model Purchase {
  id               String                 @id @default(cuid())
  purchaseNumber   String                 @unique
  supplierId       String
  supplier         Supplier               @relation(fields: [supplierId], references: [id])
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  dueDate          DateTime?
  totalAmount      Decimal                @db.Decimal(12, 2)
  paidAmount       Decimal                @default(0) @db.Decimal(12, 2)
  paymentMethod    String?
  invoiceRef       String?
  notes            String?                @db.Text
  deliveryStatus   PurchaseDeliveryStatus @default(PENDING)
  items            PurchaseItem[]
  stockMovements   StockMovement[]

  @@index([supplierId, createdAt])
  @@index([deliveryStatus, createdAt])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 2)
  lineTotal  Decimal  @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([productId])
}

model ContactMessage {
  id         String               @id @default(cuid())
  name       String
  email      String
  phone      String?
  subject    String
  message    String               @db.Text
  status     ContactMessageStatus @default(NEW)
  adminReply String?              @db.Text
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

model Faq {
  id         String   @id @default(cuid())
  questionAr String   @db.Text
  questionEn String   @db.Text
  answerAr   String   @db.Text
  answerEn   String   @db.Text
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active, sortOrder])
}

model Review {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName   String?
  guestEmail  String?
  rating      Int
  title       String       @db.VarChar(100)
  body        String       @db.Text
  images      String[]
  status      ReviewStatus @default(PENDING)
  helpfulCount Int         @default(0)
  adminReply  String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  verified    Boolean      @default(false)
  helpfulVotes ReviewHelpfulVote[]

  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}

model ReviewHelpfulVote {
  id         String   @id @default(cuid())
  reviewId   String
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipHash     String
  createdAt  DateTime @default(now())

  @@unique([reviewId, userId])
  @@unique([reviewId, ipHash])
  @@index([reviewId, createdAt])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model ProductStockAlert {
  id        String   @id @default(cuid())
  productId String
  email     String   @db.VarChar(320)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, email])
  @@index([productId])
}

model StockMovement {
  id         String            @id @default(cuid())
  type       StockMovementType
  quantity   Int
  productId  String
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?             @relation(fields: [userId], references: [id])
  supplierId String?
  supplier   Supplier?         @relation(fields: [supplierId], references: [id])
  purchaseId String?
  purchase   Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  unitCost   Decimal?          @db.Decimal(12, 2)
  reason     String?
  notes      String?           @db.Text
  createdAt  DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
  @@index([type, createdAt])
  @@index([purchaseId])
}

model Order {
  id          String      @id @default(cuid())
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  guestEmail   String?
  guestName    String?
  guestPhone   String?
  guestAddress String?
  guestCity    String?

  shippingCost  Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod String        @default("CASH_ON_DELIVERY")
  isVerified    Boolean       @default(false)

  customerNotes String? @db.Text
  couponCode    String?

  items   OrderItem[]
  invoice Invoice?
  returns OrderReturn[]

  @@index([userId, status, createdAt])
}

model UserAddress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String?
  fullName    String
  phone       String
  addressLine String
  city        String
  governorate String?
  street      String?
  building    String?
  floor       String?
  notes       String?  @db.Text
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  percentOff Int
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Invoice {
  id             String   @id @default(cuid())
  invoiceNumber  String   @unique
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  totalAmount    Decimal  @db.Decimal(12, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  qrCode         String?  @db.Text
  issuedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Banner {
  id          String   @id @default(cuid())
  titleAr     String
  titleEn     String
  subtitleAr  String
  subtitleEn  String
  image       String
  ctaTextAr   String
  ctaTextEn   String
  ctaLink     String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Offer {
  id          String    @id @default(cuid())
  titleAr     String
  titleEn     String
  subtitleAr  String
  subtitleEn  String
  image       String
  ctaTextAr   String
  ctaTextEn   String
  ctaLink     String
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model OrderItem {
  id        String   @id @default(cuid())
  quantity  Int
  price     Decimal  @db.Decimal(12, 2)
  orderId   String
  productId String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Transaction {
  id             String          @id @default(cuid())
  type           TransactionType
  amount         Decimal         @db.Decimal(12, 2)
  description    String
  category       String
  reference      String?
  date           DateTime        @default(now())
  receiptUrl     String?
  paymentMethod  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Attendance {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date])
}

model SalaryRecord {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  month       Int
  year        Int
  baseSalary  Decimal      @db.Decimal(12, 2)
  bonuses     Decimal      @default(0) @db.Decimal(12, 2)
  deductions  Decimal      @default(0) @db.Decimal(12, 2)
  netSalary   Decimal      @db.Decimal(12, 2)
  status      SalaryStatus @default(PENDING)
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([userId, month, year])
  @@index([userId, year, month])
}

model LeaveRequest {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        LeaveType
  fromDate    DateTime
  toDate      DateTime
  days        Int
  reason      String?     @db.Text
  status      LeaveStatus @default(PENDING)
  adminNotes  String?     @db.Text
  reviewedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId, fromDate])
  @@index([status])
}

model OrderReturn {
  id           String         @id @default(cuid())
  returnNumber String         @unique
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id])
  reason       String         @db.Text
  refundAmount Decimal        @db.Decimal(12, 2)
  refundMethod String         @default("CASH")
  status       ReturnStatus   @default(PENDING)
  processedAt  DateTime?
  notes        String?        @db.Text
  items        OrderReturnItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([orderId])
  @@index([status])
}

model OrderReturnItem {
  id        String      @id @default(cuid())
  returnId  String
  return    OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal     @db.Decimal(12, 2)
  createdAt DateTime    @default(now())

  @@index([returnId])
}

model LedgerInvoice {
  id            String                  @id @default(cuid())
  invoiceNumber String                  @unique
  direction     LedgerInvoiceDirection
  partyName     String
  amount        Decimal                 @db.Decimal(12, 2)
  dueDate       DateTime?
  paidAt        DateTime?
  status        LedgerInvoiceStatus     @default(PENDING)
  notes         String?                 @db.Text
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([status, dueDate])
}

model RateLimit {
  id         String   @id @default(cuid())
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

model Store {
  id                              String   @id @default(cuid())
  nameAr                          String
  nameEn                          String
  sloganAr                        String?
  sloganEn                        String?
  logoUrl                         String?
  faviconUrl                      String?
  contactPhone                    String?
  contactEmail                    String?
  addressAr                       String?
  addressEn                       String?
  googleMapsLink                  String?
  facebookUrl                     String?
  instagramUrl                    String?
  whatsappUrl                     String?
  tiktokUrl                       String?
  currency                        String   @default("SDG")
  currencySymbolPosition          String   @default("END")
  defaultLanguage                 String   @default("ar")
  maintenanceMode                 Boolean  @default(false)
  businessHoursJson               Json?
  globalFreeShippingEnabled       Boolean  @default(false)
  globalFreeShippingAmount        Decimal? @db.Decimal(12, 2)
  cashOnDeliveryEnabled           Boolean  @default(true)
  deliveryNotesAr                 String?  @db.Text
  deliveryNotesEn                 String?  @db.Text
  defaultDeliveryEstimateAr       String?
  defaultDeliveryEstimateEn       String?
  returnPolicyAr                  String?  @db.Text
  returnPolicyEn                  String?  @db.Text
  invoicePrefix                   String   @default("INV-")
  vatEnabled                      Boolean  @default(false)
  vatPercentage                   Decimal? @db.Decimal(5, 2)
  vatLabelAr                      String?
  vatLabelEn                      String?
  minOrderAmount                  Decimal? @db.Decimal(12, 2)
  seoMetaTitleAr                  String?
  seoMetaTitleEn                  String?
  seoMetaDescriptionAr            String?  @db.Text
  seoMetaDescriptionEn            String?  @db.Text
  seoOgImageUrl                   String?
  googleAnalyticsId               String?
  googleSearchConsoleVerification String?
  robotsTxt                       String?  @db.Text
  backupSchedule                  String   @default("OFF")
  backupLastStatus                String?
  backupLastAt                    DateTime?
  appVersion                      String?  @default("0.1.0")
  aboutStoryAr                    String?  @db.Text
  aboutStoryEn                    String?  @db.Text
  aboutMissionAr                  String?  @db.Text
  aboutMissionEn                  String?  @db.Text
  aboutVisionAr                   String?  @db.Text
  aboutVisionEn                   String?  @db.Text
  aboutImageUrl                   String?
  aboutFoundedYear                Int?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  shippingZones        ShippingZone[]
  paymentMethods       PaymentMethod[]
  notificationConfig   NotificationConfig?
}

model AboutFeature {
  id        String   @id @default(cuid())
  titleAr   String
  titleEn   String
  descAr    String   @db.Text
  descEn    String   @db.Text
  iconKey   String   @default("Shield")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id         String   @id @default(cuid())
  nameAr     String
  nameEn     String
  positionAr String
  positionEn String
  photo      String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model LegalPage {
  id        String        @id @default(cuid())
  type      LegalPageType @unique
  contentAr String        @db.Text
  contentEn String        @db.Text
  updatedAt DateTime      @updatedAt
}

model ShippingZone {
  id                       String   @id @default(cuid())
  storeId                  String
  store                    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  zoneName                 String
  governorates             String[]
  shippingCost             Decimal  @db.Decimal(12, 2)
  freeShippingMinOrder     Decimal? @db.Decimal(12, 2)
  deliveryDaysEstimate     String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model PaymentMethod {
  id                 String   @id @default(cuid())
  storeId            String
  store              Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code               String
  labelAr            String
  labelEn            String
  isEnabled          Boolean  @default(true)
  apiKey             String?
  apiSecret          String?
  instructionsAr     String?  @db.Text
  instructionsEn     String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([storeId, code])
}

model NotificationConfig {
  id                          String   @id @default(cuid())
  storeId                     String   @unique
  store                       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  emailNewOrderAdmin          Boolean  @default(true)
  emailOrderStatusCustomer    Boolean  @default(true)
  emailLowStockAdmin          Boolean  @default(true)
  emailNewReturnAdmin         Boolean  @default(true)
  smsWhatsappEnabled          Boolean  @default(false)
  adminRecipients             String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  titleAr   String
  titleEn   String
  bodyAr    String           @db.Text
  bodyEn    String           @db.Text
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
  @@index([type, createdAt])
}

model Permission {
  id         String   @id @default(cuid())
  role       Role
  module     String
  canView    Boolean  @default(false)
  canCreate  Boolean  @default(false)
  canEdit    Boolean  @default(false)
  canDelete  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([role, module])
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
  CUSTOMER
}

enum StockMovementType {
  IN
  OUT
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TransactionType {
  INCOMING
  OUTGOING
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  HOLIDAY
}

enum SalaryStatus {
  PENDING
  PROCESSING
  PAID
}

enum LeaveType {
  ANNUAL
  SICK
  EMERGENCY
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REFUNDED
  REJECTED
}

enum LedgerInvoiceDirection {
  PAYABLE
  RECEIVABLE
}

enum LedgerInvoiceStatus {
  PENDING
  PAID
  OVERDUE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PurchaseDeliveryStatus {
  PENDING
  PARTIAL
  RECEIVED
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
}

enum LegalPageType {
  TERMS
  PRIVACY
}

enum NotificationType {
  NEW_ORDER
  LOW_STOCK
  NEW_REVIEW
  NEW_MESSAGE
  ORDER_STATUS
  PAYMENT_RECEIVED
  NEW_USER
  SYSTEM
}
